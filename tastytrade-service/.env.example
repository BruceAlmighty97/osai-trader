# tastytrade SANDBOX (certification) credentials.
# Create a sandbox account at https://developer.tastytrade.com/sandbox/
# then copy this file to `.env` and fill in the values. NEVER commit .env.

# Environment: "sandbox" (api.cert.tastyworks.com) or "production" (api.tastyworks.com)
# Use "production" for REAL market metrics with the imaginary/paper account.
TT_ENV=sandbox

# Paper trading: "paper" tracks an imaginary account in our DB and never sends
# orders to the broker (the only supported mode). Commission modeled per contract
# on open (tastytrade ≈ $1 open / $0 close).
TRADING_MODE=paper
COMMISSION_PER_CONTRACT=1

# Auth: two modes.
#  - OAuth2 (REQUIRED for production): set TT_REFRESH_TOKEN + TT_CLIENT_SECRET.
#    Create at my.tastytrade.com -> Manage -> My Profile -> API -> OAuth
#    Applications -> New OAuth client (scopes: read, trade), then Manage ->
#    Create Grant to get the (long-lived) refresh token. Env-specific: a
#    production app/token won't work on sandbox and vice-versa.
#  - Session auth (sandbox only / simplest): set TT_USERNAME + TT_PASSWORD.
# If a refresh token is present the app uses OAuth; otherwise it uses session.
TT_REFRESH_TOKEN=
TT_CLIENT_SECRET=

# Session auth (sandbox) — your SANDBOX login + password
TT_USERNAME=
TT_PASSWORD=

# HTTP port for this service
PORT=3100

# API key required on every request via the `X-API-Key` header (except /health
# and Swagger). In prod this comes from the osai-trader/api-key secret; set any
# value here for local dev. If left blank, auth is disabled in non-production
# and FAILS CLOSED (denies all) when NODE_ENV=production.
API_KEY=

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=osaitrader
DB_PASSWORD=osaitrader_dev
DB_NAME=osaitrader
# Log every SQL statement (very noisy — CloudWatch costs money). Default false.
# DB_LOGGING=true

ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY_HERE>

# Finnhub — earnings calendar (the pre-market hard exclusion: never sell premium
# into a report). Free key, 60 req/min: https://finnhub.io/register
FINNHUB_API_KEY=

# Pre-market qualification thresholds. IV rank is the premium-selling edge (sell
# when vol is rich); liquidity rating 1-5 from tastytrade (below 3 = spreads too
# wide to trade). Defaults 30 / 3.
# MIN_IV_RANK=30
# MIN_LIQUIDITY_RATING=3

# Entry — spread construction (always mechanical, never done by the model).
# Defaults are the 7-14 DTE playbook (docs/playbook/00-README.md canonical
# table); every value is per-arm overridable.
#
# Expiration: nearest to ENTRY_TARGET_DTE, but ONLY inside [MIN, MAX] — a chain
# with nothing in the window is skipped rather than traded at 3 or 24 DTE.
# Short strike: the strike nearest ENTRY_TARGET_DELTA among those that satisfy
# BOTH the delta band [MIN_SHORT_DELTA, MAX_SHORT_DELTA] (02 T2) AND sit at
# least ENTRY_MIN_EM_MULTIPLE x the 1-SD expected move OTM (02 T5: 1.0x
# preferred, 0.8x minimum; EM from the strike's own IV). Strikes clearing
# PREFERRED_EM_MULTIPLE are chosen first; the 0.8-1.0x band is the fallback.
# Long strike: widest that fits the risk budget (5% of NLV = $1-2 wide on SPY).
#
# Credit gates (02 T4, 01 A6): credit/width >= MIN_CREDIT_RATIO hard floor;
# between the floor and TARGET_CREDIT_RATIO only if short Δ <= THIN_CREDIT_MAX_DELTA
# (paid less, so it must sit further out); gross credit >= MIN_CREDIT_ABS per
# share so fees stay <= 10% of credit. Expect many days with no qualifying
# trade — the playbook is explicit that zero is often the right count.
#
# Quote quality is two separate tests: any leg with NO BID is untradeable and
# hard-rejected (thin sector ETFs genuinely quote 0/1.40 on OTM puts), while a
# leg is only "too wide" if it exceeds BOTH the relative and absolute
# thresholds. Relative alone is meaningless on a cheap leg — a 0.14/0.24 long
# leg reads as 53% but costs $0.10 to cross.
# ENTRY_TARGET_DELTA=0.20
# ENTRY_MIN_SHORT_DELTA=0.15
# ENTRY_MAX_SHORT_DELTA=0.25
# ENTRY_MIN_EM_MULTIPLE=0.8
# ENTRY_PREFERRED_EM_MULTIPLE=1.0
# ENTRY_WIDTH_PCT=0.05
# ENTRY_MIN_CREDIT_RATIO=0.25
# ENTRY_TARGET_CREDIT_RATIO=0.33
# ENTRY_THIN_CREDIT_MAX_DELTA=0.20
# ENTRY_MIN_CREDIT_ABS=0.30
# ENTRY_TARGET_DTE=10
# ENTRY_MIN_DTE=7
# ENTRY_MAX_DTE=14
# ENTRY_MAX_NEW_PER_RUN=1
# ENTRY_MAX_QUOTE_SPREAD_PCT=0.5
# ENTRY_MAX_QUOTE_SPREAD_ABS=0.10

# Entry — DEFAULTS for every A/B arm. Each arm (a row in paper_account) can
# override any of the ENTRY_* values above plus these, via its `config` jsonb.
# Two arms ship seeded: 'mech' {"selector":"mechanical"} and 'ai'
# {"selector":"ai"}; see docs/trading-day.md.
#   mechanical = highest deterministic score. This is the baseline.
#   ai         = Claude picks from the same scored slate, weighing portfolio fit
#                against that arm's open book. Needs ANTHROPIC_API_KEY; falls
#                back to the mechanical pick if unavailable.
# The mechanical baseline is logged for EVERY arm on every run, so an arm's lift
# is measurable rather than assumed. Candidates are unioned across arms and each
# chain is fetched ONCE (an ~8s snapshot), so arms score off identical prices.
# ENTRY_SELECTOR=mechanical
# ENTRY_SLATE_SIZE=5
# ENTRY_MODEL=claude-opus-5

# Manage — the exit rules (playbook 06 §5.2 / §6.2, 02 T6-T8, 03 G-rules),
# evaluated on EVERY 5-minute tick 09:35-15:55 ET. Firing order is the
# priority and is what gets journaled: expired > stop loss > price touch >
# delta stop > profit target > time exit. Rules live in trading/exit-rules.ts.
#   MANAGE_STOP_LOSS_MULTIPLE     close when unrealized loss >= N x MAX PROFIT.
#                                 1 = the playbook's "mark >= 2x credit" (a loss
#                                 equal to the credit). Always capped at 0.5 x
#                                 max risk, which is the rich-credit and
#                                 debit-spread variant of the same rule.
#   MANAGE_DELTA_STOP             short strike |delta| at which a credit
#                                 position is "tested" and closed (0.40);
#   MANAGE_DELTA_STOP_CONDOR      same for iron condors (0.35)
#   MANAGE_DEBIT_LONG_DELTA_STOP  debit structures: long leg |delta| at/below
#                                 which the thesis has failed (0.20)
#   MANAGE_PROFIT_TARGET_PCT      close at N of max profit (0.5)
#   MANAGE_ACCEL_PROFIT_TARGET_PCT  ...or at this once MANAGE_ACCEL_DTE or fewer
#   MANAGE_ACCEL_DTE              calendar days remain (0.25 / 3); iron flies
#                                 always use the accelerated target
#   MANAGE_TIME_STOP_TRADING_DAYS close this many TRADING days before expiry
#                                 (2 — Wednesday for a Friday expiry, holidays
#                                 skipped), from MANAGE_TIME_STOP_FROM_MINUTE
#                                 (600 = 10:00 ET) on that day; immediately if
#                                 the day was missed. Positions opened under the
#                                 old 45-DTE policy (> 21 DTE at open) still exit
#                                 at 21 DTE.
# The price-touch stop has no knob: any print at/through a short strike in
# today's session (dxfeed Summary range, gated on today's dayId) closes it.
# A position that cannot be priced is NEVER acted on: a missing quote is not a
# signal, and closing on invented numbers writes phantom P&L into the ledger
# permanently. Arms can override every threshold (exit policy is an A/B variable).
# MANAGE_PROFIT_TARGET_PCT=0.5
# MANAGE_ACCEL_PROFIT_TARGET_PCT=0.25
# MANAGE_ACCEL_DTE=3
# MANAGE_STOP_LOSS_MULTIPLE=1
# MANAGE_DELTA_STOP=0.40
# MANAGE_DELTA_STOP_CONDOR=0.35
# MANAGE_DEBIT_LONG_DELTA_STOP=0.20
# MANAGE_TIME_STOP_TRADING_DAYS=2
# MANAGE_TIME_STOP_FROM_MINUTE=600

# Research agent — the third arm, driven by an actual Claude agent doing web
# research plus live broker data. Needs ANTHROPIC_API_KEY.
#
# Broker access is IN-PROCESS (src/research-agent/tastytrade.tools.ts wrapping
# TastytradeService), NOT tastytrade's MCP server. That server is stdio-only so
# it cannot be an ECS sidecar, and more importantly it exposes seven tools that
# place/cancel REAL orders — wrapping our own service means no order-placing
# capability exists in the process at all.
#
# RESEARCH_REQUIRE_DRY_RUN: every play is dry-run at the broker for real fees
# and buying-power numbers, but the LIVE account holds ~$250 while the arm is a
# $2,500 paper account, so realistic plays fail preflight on BP. Leave false so
# the paper risk gate is the binding constraint; set true once the live account
# is funded to at least the arm's size.
# RESEARCH_ARM=research
# RESEARCH_MODEL=claude-opus-5
# RESEARCH_MAX_BUDGET_USD=3
# RESEARCH_MAX_TURNS=60
# RESEARCH_SCHEDULE_ENABLED=false
# RESEARCH_REQUIRE_DRY_RUN=false
# Front-leg expiration must be inside this DTE window or the play is rejected
# at execution (the prompt says 7-14; this is the enforcement).
# RESEARCH_MIN_DTE=7
# RESEARCH_MAX_DTE=14

# Social-sentiment scanner — StockTwits (public endpoints, NO key needed).
# Optional — comma-separated symbols to always ingest; if unset, /social/ingest
# uses the StockTwits trending list (equities only).
# SOCIAL_SYMBOLS=SPY,QQQ,IWM
# Optional — ms between StockTwits requests (throttle). Default 1500.
# SOCIAL_REQUEST_DELAY_MS=1500
# Optional — User-Agent sent to StockTwits. Default osaitrader/0.1.
# STOCKTWITS_USER_AGENT=osaitrader/0.1

# Reddit attention — ApeWisdom (aggregate mention counts, NO key, no login).
# Optional — which ApeWisdom list to read: all-stocks (default) | all |
# wallstreetbets | stocks | options | Daytrading | ...
# APEWISDOM_FILTER=all-stocks
# Optional — how many of the top Reddit tickers join pre-market discovery.
# 0 disables Reddit discovery (survivors still get mention counts). Default 25.
# APEWISDOM_DISCOVER_TOP=25
# Optional — ms to cache an ApeWisdom page. Default 300000 (5 min).
# APEWISDOM_CACHE_TTL_MS=300000